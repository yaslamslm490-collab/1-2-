# Environment configuration
# Server-side only. Configure actual values as Vercel Environment Variables/Secrets.
# Never prefix any API key, password, or token with VITE_ (Vite exposes VITE_* to the browser).
OWNER_API_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional: gemini, openai, or anthropic. Auto uses this configured provider; otherwise it defaults only to Gemini.
NADA_DEFAULT_AI_PROVIDER=
# Optional JSON array of additional provider metadata; it must contain variable names only.
NADA_INTEGRATION_CATALOG=
